<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hellomusic</groupId>
    <artifactId>HelloMusic</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>HelloMusic</name>
    <description>Local music server with Unix socket control plane and HTTP media stream</description>

    <licenses>
        <license>
            <name>GNU General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- 未填 <url> / <organization>：本仓库没有公开地址，也没有组织主体。
         挂上占位值只会让 `mvn site` 生成一堆点不动的链接，不如留空。 -->
    <developers>
        <developer>
            <id>lujiafan</id>
            <name>Lu Jiafan</name>
            <roles>
                <role>maintainer</role>
            </roles>
        </developer>
    </developers>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 测试 JVM 通过 mockito-extensions/org.mockito.plugins.MockMaker 指定 mock-maker-subclass，
             避免 byte-buddy java agent 自挂载（容器/受限沙箱里会被内核 EPERM 拦截）。 -->
        <argLine>-XX:+EnableDynamicAgentLoading</argLine>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- hibernate-validator 8.0.1.Final 传递依赖 classmate 1.5.1，但本机仓库
                 只有 1.6.0 的 jar（1.5.1 仅存 pom，jar 下载失败）。classmate 只被校验器
                 内部用于反射元数据，OSGi 声明兼容 [1.3,2.0.0)，这里统一钉到 1.6.0。 -->
            <dependency>
                <groupId>com.fasterxml</groupId>
                <artifactId>classmate</artifactId>
                <version>1.6.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- JSON 序列化：jackson-databind + jsr310（LocalDateTime 需要 JavaTimeModule） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.3</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>2.15.3</version>
        </dependency>

        <!-- 日志：SLF4J API + Logback 实现（LoggingInstaller 依赖 logback 的 FileAppender） -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.9</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.4.11</version>
        </dependency>

        <!-- Bean Validation：ConfigManager 用 jakarta.validation 做配置体检。
             hibernate-validator 是校验实现，tomcat-embed-el 提供它运行所需的
             jakarta.el 实现（本机仓库无独立 jakarta.el 包，tomcat-embed-el 自带） -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.0.2</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <version>8.0.1.Final</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-el</artifactId>
            <version>10.1.16</version>
        </dependency>

        <!-- 工具：commons-io（FilenameUtils） -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.15.1</version>
        </dependency>

        <!-- 音频元数据解析：MP3(ID3v1/v2, 中文 UTF-8/GBK)、FLAC、M4A/MP4、OGG、WAV 等 -->
        <dependency>
            <groupId>net.jthink</groupId>
            <artifactId>jaudiotagger</artifactId>
            <version>3.0.1</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.7.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>HelloMusic</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <argLine>${argLine}</argLine>
                </configuration>
            </plugin>
            <!-- 打可执行 fat jar（内含全部依赖），java -jar HelloMusic.jar 即可运行 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>core.HelloMusicApplication</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
